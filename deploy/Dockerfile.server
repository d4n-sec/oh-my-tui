# Multi-stage build for the Oh-My-TUI Server.
# Build context is the repository root: docker build -f deploy/Dockerfile.server .

FROM node:24-bookworm-slim AS build
WORKDIR /repo
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/protocol/package.json packages/protocol/
COPY packages/agent/package.json packages/agent/
COPY apps/server/package.json apps/server/
COPY apps/web/package.json apps/web/
RUN npm ci
COPY packages/protocol packages/protocol
COPY apps/server apps/server
COPY apps/web apps/web
RUN npm run build:protocol && npm run build:web && npm run build:server

FROM node:24-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
RUN groupadd --system --gid 10001 otm \
  && useradd --system --uid 10001 --gid otm --create-home otm \
  && mkdir -p /data && chown otm:otm /data
COPY --from=build /repo/node_modules ./node_modules
COPY --from=build /repo/package.json ./package.json
COPY --from=build /repo/packages/protocol/package.json ./packages/protocol/package.json
COPY --from=build /repo/packages/protocol/dist ./packages/protocol/dist
COPY --from=build /repo/apps/server/package.json ./apps/server/package.json
COPY --from=build /repo/apps/server/dist ./apps/server/dist
COPY --from=build /repo/apps/web/dist ./web
USER otm
ENV DATA_DIR=/data \
    DOCKER_ENV=1 \
    WEB_STATIC_DIR=/app/web \
    WEB_LISTEN_HOST=0.0.0.0 \
    WEB_PORT=8080 \
    AGENT_LISTEN_HOST=0.0.0.0 \
    AGENT_PORT=8443
EXPOSE 8080 8443
CMD ["node", "apps/server/dist/index.js"]
