# Copy to deploy/.env and edit. Never commit real values.

# --- Public hosts served by Caddy (automatic HTTPS) ---
# Real domains: DNS must point here and inbound 80/443 must reach this host.
# For local/no-domain use set both to "localhost" (Caddy uses its internal CA;
# extract it with deploy/scripts/caddy-root-ca.sh).
WEB_HOST=terminal.example.com
AGENT_HOST=terminal.example.com

# Port the AGENT entrance listens on (Caddy site port).
AGENT_PORT=8443

# --- Origins the Server expects (must match the hosts above) ---
WEB_ORIGIN=https://terminal.example.com
AGENT_ORIGIN=https://terminal.example.com:8443

# Address embedded in generated enroll commands, when it differs from
# AGENT_ORIGIN (complex networks / NAT / relay). Reachability is out of scope.
# AGENT_CONNECT_HOST=203.0.113.9
# AGENT_CONNECT_PORT=8443

# --- Published ports / interface ---
# 0.0.0.0 for direct public TLS; use 127.0.0.1 only if another proxy is in front.
BIND_ADDR=0.0.0.0
ACME_HTTP_PORT=80
WEB_PORT_PUBLISHED=443
AGENT_PORT_PUBLISHED=8443

# Which Caddyfile to mount:
#   Caddyfile        automatic HTTPS: public domains (ACME) or localhost/*.local/IP (internal CA)
#   Caddyfile.local  internal CA for any LAN/bare hostname (extract CA with caddy-root-ca.sh)
#   Caddyfile.certs  bring your own deploy/certs/server.pem + server.key
CADDYFILE=Caddyfile

# --- Behind your own reverse proxy (no bundled Caddy) ---
# Use deploy/docker-compose.behind-proxy.yml. The Server is then plain HTTP and
# published on BIND_ADDR; point your proxy at these loopback ports.
SERVER_WEB_PORT=8080
SERVER_AGENT_PORT=8443

# --- Server behaviour ---
SECURE_COOKIES=true
SERVER_IMAGE=oh-my-tui/server:0.1.0
SESSION_IDLE_TIMEOUT_MINUTES=5
SESSION_TTL_HOURS=336
TOKEN_TTL_MINUTES=15
OFFLINE_AFTER_MS=45000

# 0 = a machine may announce itself at any time (recommended for a private host).
ENROLL_PAIRING_WINDOW_MINUTES=0
ENROLL_RATE_LIMIT_PER_MINUTE=30

# Resource limits.
SERVER_MEM_LIMIT=1g
SERVER_CPUS=2.0

LOG_LEVEL=info
