{
  "name": "@oh-my-tui/server",
  "version": "0.1.0-beta.2",
  "description": "Oh-My-TUI Server: two-port service for owner auth, enrollment, and SSH terminals",
  "license": "MIT",
  "author": "d4n-sec",
  "keywords": [
    "terminal",
    "ssh",
    "tmux",
    "remote",
    "server",
    "webauthn"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "bin": {
    "terminal-server": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "node dist/cli.js",
    "admin": "node dist/admin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "pack": "npm run build && npm pack"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.0.2",
    "@simplewebauthn/server": "^11.0.0",
    "fastify": "^5.2.1",
    "ssh2": "^1.16.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@oh-my-tui/protocol": "0.1.0",
    "@types/node": "^22.15.0",
    "@types/ssh2": "^1.15.1",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d4n-sec/oh-my-tui.git"
  }
}
