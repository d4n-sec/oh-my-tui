{
  "name": "@oh-my-tui/agent",
  "version": "0.1.0-beta.2",
  "description": "Oh-My-TUI terminal agent: enroll a machine and expose its local sshd to the owner's Server",
  "license": "MIT",
  "author": "d4n-sec",
  "keywords": [
    "terminal",
    "ssh",
    "tmux",
    "remote",
    "agent",
    "pty"
  ],
  "bin": {
    "terminal-agent": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node build-tests.mjs && node --test dist-test/*.test.js",
    "pack": "npm run build && npm pack"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@oh-my-tui/protocol": "0.1.0",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d4n-sec/oh-my-tui.git"
  }
}
